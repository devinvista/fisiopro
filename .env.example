# =============================================================================
# FisioGest Pro — variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env` e preencha com valores reais.
# NUNCA commite o `.env` (já está no .gitignore).
#
# Em produção (Hostinger / VPS) configure essas variáveis em .env
# ou nas variáveis de ambiente do painel Node.js do Hostinger.
# =============================================================================

# -----------------------------------------------------------------------------
# Núcleo (obrigatórias)
# -----------------------------------------------------------------------------

# String de conexão PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Chave secreta para assinatura de JWT — gere com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-with-a-long-random-string

# Ambiente de execução
NODE_ENV=production

# Porta em que o servidor vai escutar (padrão 3000)
PORT=3000

# -----------------------------------------------------------------------------
# CORS / rede (produção)
# -----------------------------------------------------------------------------

# URL pública do frontend — usada para gerar links absolutos e restringir CORS.
# Separe por vírgula se houver mais de um domínio.
APP_PUBLIC_URL=https://seu-dominio.com.br
CORS_ORIGIN=https://seu-dominio.com.br

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------

# Nível de log do pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Asaas (pagamentos / cobrança SaaS)
# -----------------------------------------------------------------------------

# Chave de API Asaas — use a chave de PRODUÇÃO ao ir ao ar
ASAAS_API_KEY=$aact_SuaChaveDeProducaoAqui

# URL base da API Asaas
# Sandbox:   https://sandbox.asaas.com/api/v3
# Produção:  https://api.asaas.com/api/v3
ASAAS_BASE_URL=https://api.asaas.com/api/v3

# Token para validar webhooks recebidos do Asaas
ASAAS_WEBHOOK_TOKEN=seu-token-de-webhook

# -----------------------------------------------------------------------------
# Cloudinary (upload de fotos de pacientes / atestados)
# -----------------------------------------------------------------------------
# Use a URL única (CLOUDINARY_URL) OU as três variáveis separadas.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Observabilidade (opcional — Sentry)
# -----------------------------------------------------------------------------

# Backend
SENTRY_DSN_BACKEND=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend (Vite — qualquer variável exposta ao client deve começar com VITE_)
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
