modules = ["python-3.12", "web", "nodejs-22", "postgresql-16"]
[[artifacts]]
id = "artifacts/api-server"
[[artifacts]]
id = "artifacts/fisiogest"
[nix]
channel = "stable-25_05"
[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["pnpm", "run", "start"]
build = ["pnpm", "run", "build"]
[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8081
externalPort = 8081

[userenv]

[userenv.shared]
CLOUDINARY_CLOUD_NAME = "dqsg4f7uv"
CLOUDINARY_API_KEY = "531994692338197"


[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run dev"
waitForPort = 5000
